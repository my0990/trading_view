# 한국투자증권 Open API (https://apiportal.koreainvestment.com) 에서 발급받은 실전 앱키
# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요. (.env.local 은 git에 올라가지 않습니다)
KIS_APP_KEY=
KIS_APP_SECRET=

# 앱키 이용기간 만료일 (YYYY-MM-DD). 30일 전부터 야간선물 카드에 경고가 뜹니다
KIS_KEY_EXPIRES=

# 선택: 야간선물 시장 분류 코드 (기본 CM)
# KIS_NIGHT_MRKT_CODE=CM
# 선택: 종목코드 직접 지정 (기본은 최근월물 자동 계산, 예: A01612 / A06612)
# KIS_KOSPI200_CODE=
# KIS_KOSDAQ150_CODE=
